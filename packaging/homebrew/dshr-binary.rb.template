class Dshr < Formula
  desc "Rust-native agent harness (TUI, headless, HTTP/SSE, ACP)"
  homepage "https://github.com/maximusmakarov/deepseek_harness_rust"
  version "__VERSION__"
  license "MIT"

__BOTTLES__

  on_macos do
    on_arm do
      url "https://github.com/maximusmakarov/deepseek_harness_rust/releases/download/v__VERSION__/dshr-__VERSION__-aarch64-apple-darwin.tar.gz"
      sha256 "__SHA_ARM64_MACOS__"
    end

    on_intel do
      url "https://github.com/maximusmakarov/deepseek_harness_rust/releases/download/v__VERSION__/dshr-__VERSION__-x86_64-apple-darwin.tar.gz"
      sha256 "__SHA_X86_64_MACOS__"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/maximusmakarov/deepseek_harness_rust/releases/download/v__VERSION__/dshr-__VERSION__-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_ARM64_LINUX__"
    end

    on_intel do
      url "https://github.com/maximusmakarov/deepseek_harness_rust/releases/download/v__VERSION__/dshr-__VERSION__-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "__SHA_X86_64_LINUX__"
    end
  end

  def install
    bin.install "dshr"
  end

  test do
    assert_match "dshr", shell_output("#{bin}/dshr --version")
  end
end
